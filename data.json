   "cat": "News",
   "img": "",
   "sum": "Your independent island news and cultural portal is live on GitHub.",
   "body": "<p>Welcome to <b>Times of Lakshadweep</b>. This website is now live, featuring full coverage of island affairs, administration updates, education, sports, jobs, and lifestyle.</p><p>News editors can log in to the <b>Admin Portal</b> to write, edit, upload photos, and publish new stories in real time.</p>",
   "tpl": "default",
   "st": "pub",
   "feat": true,
   "author": "Chief Editor",
   "date": "2026-11-22T00:00:00.000Z",
   "note": ""
  }
 ],
 "pages": [
  {
   "id": "about",
   "title": "About Us",
   "body": "<p><b>Times of Lakshadweep</b> is dedicated to bringing independent, accurate, and timely journalism to the people of Lakshadweep and the global diaspora.</p><p>We cover local news, governance policies, marine environment, education, sports, and cultural heritage from every island including Kavaratti, Agatti, Andrott, Amini, Kadmat, Kiltan, Chetlat, Bitra, Kalpeni, and Minicoy.</p>",
   "menu": true
  },
  {
   "id": "contact",
   "title": "Contact & Press Inquiries",
   "body": "<p>We welcome news tips, opinion submissions, press releases, and advertising queries.</p><p><b>Email:</b> editor@timesoflakshadweep.com<br><b>Location:</b> Lakshadweep, India</p>",
   "menu": true
  }
